<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RootNamespace>SizeMap.Harness</RootNamespace>
    <AssemblyName>SizeMap.Harness</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- The engine is netstandard2.0 so it also compiles inside NinjaTrader. Referencing it
         here is what makes the harness show the SAME pixels, not a lookalike. -->
    <ProjectReference Include="..\engine\SizeMap.Engine.csproj" />
  </ItemGroup>
</Project>
