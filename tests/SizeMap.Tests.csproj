<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\engine\SizeMap.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The NT8 writer, compiled straight into the test assembly. It touches exactly one
         NinjaTrader symbol (Globals.UserDataDir), stubbed in RecorderWriterTests.cs, so the
         file-rollover logic can be tested without the platform. -->
    <Compile Include="..\nt8\SizeMapRecorder.cs" />
    <!-- The harness' PNG encoder, same trick: it is `internal` and has no dependencies, so
         compiling it in is cheaper than referencing an Exe project just to test 60 lines. -->
    <Compile Include="..\harness\Png.cs" />
  </ItemGroup>
</Project>
